{
    "name": "event-planner",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "typecheck": "tsc -b",
        "lint": "eslint .",
        "preview": "vite preview",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,html,md}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,html,md}\"",
        "prettier": "pnpm format",
        "test": "vitest run --coverage --logHeapUsage",
        "madge": "madge src/main.tsx --circular --ts-config tsconfig.app.json --warning",
        "prepare": "husky"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.2.2",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@tanstack/react-query": "^5.100.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-hook-form": "^7.56.2",
        "react-router": "^7.5.3",
        "zod": "^4.3.6",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@eslint/js": "^9.26.0",
        "@tailwindcss/vite": "^4.2.4",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@types/node": "^22.15.3",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^4.4.1",
        "@vitest/coverage-v8": "^3.1.2",
        "eslint": "^9.26.0",
        "eslint-config-prettier": "^10.1.2",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prettier": "^5.3.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "globals": "^16.0.0",
        "husky": "^9.1.7",
        "jsdom": "^26.1.0",
        "lint-staged": "^15.5.1",
        "madge": "^8.0.0",
        "prettier": "^3.5.3",
        "tailwindcss": "^4.2.4",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.31.1",
        "vite": "^6.3.4",
        "vitest": "^3.1.2"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "pnpm lint",
            "pnpm madge",
            "pnpm test ."
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "publishConfig": {
        "commitHooks": false
    }
}
